# Copia este archivo a .env.local. Solo van valores públicos del cliente.
# Sin estas dos variables la aplicación corre en modo muestra.
# La service-role key y SERVER_SECRET nunca van aquí ni en ningún VITE_*:
# viven solo en las variables de entorno de las Edge Functions.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
